<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the demo history be loaded from adb. DUMP is held by the shell, not by apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DemoSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".PropertyProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
